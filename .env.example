# Keep actual credentials in ignored .env, never in source control.
DB_URL=jdbc:postgresql://localhost:5433/contextiq
DB_USERNAME=
DB_PASSWORD=
DB_PORT=5433
FRONTEND_URL=http://localhost:5173
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false for localhost HTTP; true for HTTPS deployments
SESSION_COOKIE_SECURE=false
